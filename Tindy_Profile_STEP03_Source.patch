diff --git a/tests/Tindy.Tests/Onboarding/OnboardingWriteLockTests.cs b/tests/Tindy.Tests/Onboarding/OnboardingWriteLockTests.cs
new file mode 100644
index 0000000..95e5ee7
--- /dev/null
+++ b/tests/Tindy.Tests/Onboarding/OnboardingWriteLockTests.cs
@@ -0,0 +1,233 @@
+using System.Text.Json;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging.Abstractions;
+using Tindy.Api.ExceptionHandlers;
+using Tindy.Application.DTOs.Onboarding;
+using Tindy.Application.Entities;
+using Tindy.Application.Exceptions;
+using Tindy.Application.Interfaces.Repositories;
+using Tindy.Application.Services;
+using Xunit;
+
+namespace Tindy.Tests.Onboarding;
+
+/// <summary>Service and exception-handler tests; no Docker or database required.</summary>
+public sealed class OnboardingWriteLockTests
+{
+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(3)]
+    [InlineData(4)]
+    [InlineData(5)]
+    [InlineData(6)]
+    [InlineData(7)]
+    public async Task SaveStep_AfterCompletion_ThrowsBeforeAnyMutation(int step)
+    {
+        var repo = new FakeOnboardingRepository(completed: true);
+        var user = repo.User;
+        var originalUpdatedAt = user.UpdatedAt;
+        var originalProfileUpdatedAt = user.Profile!.UpdatedAt;
+        var originalStepTimes = user.OnboardingSteps.OrderBy(x => x.StepNumber).Select(x => x.CompletedAt).ToArray();
+        var originalSkillIds = user.Profile.UserSkills.Select(x => x.SkillId).ToArray();
+
+        await Assert.ThrowsAsync<OnboardingAlreadyCompletedException>(() => SaveStepAsync(repo, step));
+
+        Assert.Equal("existing_user", user.Username);
+        Assert.Equal("Existing Name", user.Profile.DisplayName);
+        Assert.Equal("FPT University", user.Profile.University);
+        Assert.Equal("Original interests", user.Profile.ProfessionalInterests);
+        Assert.Equal("Original goals", user.Profile.LearningGoals);
+        Assert.Equal(12, user.Profile.AvailableHoursPerWeek);
+        Assert.Equal("Existing project", user.Profile.PreviousProjectsAndContribution);
+        Assert.Equal("Existing technologies", user.Profile.TechnologiesToLearn);
+        Assert.Equal("https://github.com/existing", user.Profile.GithubUrl);
+        Assert.Equal("https://example.com", user.Profile.PersonalWebsiteUrl);
+        Assert.Equal(repo.RoleId, user.Profile.PreferredRoleId);
+        Assert.Equal(originalSkillIds, user.Profile.UserSkills.Select(x => x.SkillId).ToArray());
+        Assert.Equal(originalStepTimes, user.OnboardingSteps.OrderBy(x => x.StepNumber).Select(x => x.CompletedAt).ToArray());
+        Assert.Equal(originalUpdatedAt, user.UpdatedAt);
+        Assert.Equal(originalProfileUpdatedAt, user.Profile.UpdatedAt);
+        Assert.Equal(0, repo.SaveCount);
+        Assert.Equal(0, repo.UsernameCheckCount);
+        Assert.Equal(0, repo.CatalogLookupCount);
+        Assert.Equal(0, repo.SyncCount);
+        Assert.Equal(1, repo.TransactionCount);
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(3)]
+    [InlineData(4)]
+    [InlineData(5)]
+    [InlineData(6)]
+    [InlineData(7)]
+    public async Task SaveStep_BeforeCompletion_RemainsWritable(int step)
+    {
+        var repo = new FakeOnboardingRepository(completed: false);
+
+        var result = await SaveStepAsync(repo, step);
+
+        Assert.Equal(step, result.SavedStep);
+        Assert.False(result.IsOnboardingCompleted);
+        Assert.Equal(1, repo.SaveCount);
+        Assert.Equal(1, repo.TransactionCount);
+    }
+
+    [Fact]
+    public async Task CompletedAccount_GetDraftAndComplete_RemainIdempotentAndReadOnly()
+    {
+        var repo = new FakeOnboardingRepository(completed: true);
+        var service = new OnboardingService(repo);
+
+        var draft = await service.GetDraftAsync(repo.User.UserId);
+        var first = await service.CompleteAsync(repo.User.UserId, new OnboardingCompleteRequest { Confirmed = true, Bio = "Should not overwrite" });
+        var second = await service.CompleteAsync(repo.User.UserId, new OnboardingCompleteRequest { Confirmed = true });
+
+        Assert.True(draft.IsOnboardingCompleted);
+        Assert.Equal(Enumerable.Range(1, 8), draft.CompletedSteps);
+        Assert.True(first.IsOnboardingCompleted);
+        Assert.True(second.IsOnboardingCompleted);
+        Assert.Equal("Original bio", repo.User.Profile!.Bio);
+        Assert.Equal(0, repo.SaveCount);
+    }
+
+    [Fact]
+    public async Task AlreadyCompletedException_IsMappedTo409AndSpecificErrorCode()
+    {
+        using var services = new ServiceCollection().AddLogging().BuildServiceProvider();
+        var context = new DefaultHttpContext { RequestServices = services };
+        context.Request.Path = "/api/me/onboarding/4";
+        context.Response.Body = new MemoryStream();
+        var handler = new GlobalExceptionHandler(NullLogger<GlobalExceptionHandler>.Instance);
+
+        var handled = await handler.TryHandleAsync(context, new OnboardingAlreadyCompletedException(), CancellationToken.None);
+
+        Assert.True(handled);
+        Assert.Equal(StatusCodes.Status409Conflict, context.Response.StatusCode);
+        Assert.Equal("application/problem+json", context.Response.ContentType);
+        context.Response.Body.Position = 0;
+        using var body = await JsonDocument.ParseAsync(context.Response.Body);
+        Assert.Equal("ONBOARDING_ALREADY_COMPLETED", body.RootElement.GetProperty("error_code").GetString());
+        Assert.Equal(409, body.RootElement.GetProperty("status").GetInt32());
+    }
+
+    private static Task<OnboardingSaveResponse> SaveStepAsync(FakeOnboardingRepository repo, int step)
+    {
+        var service = new OnboardingService(repo);
+        var id = repo.User.UserId;
+        return step switch
+        {
+            1 => service.SaveStep1Async(id, new OnboardingStep1Request { Username = "new_user", DisplayName = "New Name", University = "New University" }),
+            2 => service.SaveStep2Async(id, new OnboardingStep2Request { SkillIds = new List<Guid> { repo.SkillId } }),
+            3 => service.SaveStep3Async(id, new OnboardingStep3Request { PreferredRoleId = repo.RoleId }),
+            4 => service.SaveStep4Async(id, new OnboardingStep4Request { ProfessionalInterests = "New interests", LearningGoals = "New goals" }),
+            5 => service.SaveStep5Async(id, new OnboardingStep5Request { AvailableHoursPerWeek = 24 }),
+            6 => service.SaveStep6Async(id, new OnboardingStep6Request { PreviousProjectsAndContribution = "New project", TechnologiesToLearn = "New technologies" }),
+            7 => service.SaveStep7Async(id, new OnboardingStep7Request { GithubUrl = "https://github.com/new", PersonalWebsiteUrl = "https://new.example.com" }),
+            _ => throw new ArgumentOutOfRangeException(nameof(step))
+        };
+    }
+
+    private sealed class FakeOnboardingRepository : IOnboardingRepository
+    {
+        public User User { get; }
+        public Guid SkillId { get; } = Guid.NewGuid();
+        public Guid RoleId { get; } = Guid.NewGuid();
+        public int SaveCount { get; private set; }
+        public int TransactionCount { get; private set; }
+        public int UsernameCheckCount { get; private set; }
+        public int CatalogLookupCount { get; private set; }
+        public int SyncCount { get; private set; }
+
+        public FakeOnboardingRepository(bool completed)
+        {
+            var userId = Guid.NewGuid();
+            var skill = new Skill { SkillId = SkillId, Name = ".NET", NameNormalized = ".net" };
+            User = new User
+            {
+                UserId = userId,
+                Username = "existing_user",
+                UsernameNormalized = "existing_user",
+                Status = "active",
+                IsOnboardingCompleted = completed,
+                UpdatedAt = DateTime.UnixEpoch,
+                Profile = new UserProfile
+                {
+                    UserId = userId,
+                    DisplayName = "Existing Name",
+                    University = "FPT University",
+                    ProfessionalInterests = "Original interests",
+                    LearningGoals = "Original goals",
+                    AvailableHoursPerWeek = 12,
+                    PreviousProjectsAndContribution = "Existing project",
+                    TechnologiesToLearn = "Existing technologies",
+                    GithubUrl = "https://github.com/existing",
+                    PersonalWebsiteUrl = "https://example.com",
+                    Bio = "Original bio",
+                    PreferredRoleId = RoleId,
+                    UpdatedAt = DateTime.UnixEpoch,
+                    UserSkills = new List<UserSkill> { new() { UserId = userId, SkillId = SkillId, Skill = skill } }
+                },
+                OnboardingSteps = Enumerable.Range(1, 7)
+                    .Select(step => new UserOnboardingStep { UserId = userId, StepNumber = step, CompletedAt = DateTime.UnixEpoch })
+                    .ToList()
+            };
+        }
+
+        public Task<User?> GetUserAsync(Guid userId, CancellationToken cancellationToken = default) =>
+            Task.FromResult(userId == User.UserId ? User : null);
+
+        public Task<bool> UsernameExistsAsync(Guid exceptUserId, string usernameNormalized, CancellationToken cancellationToken = default)
+        {
+            UsernameCheckCount++;
+            return Task.FromResult(false);
+        }
+
+        public Task<IReadOnlyList<Skill>> GetActiveSkillsByIdsAsync(IReadOnlyCollection<Guid> skillIds, CancellationToken cancellationToken = default)
+        {
+            CatalogLookupCount++;
+            IReadOnlyList<Skill> skills = skillIds.Select(id => new Skill
+            {
+                SkillId = id,
+                Name = ".NET",
+                NameNormalized = ".net"
+            }).ToArray();
+            return Task.FromResult(skills);
+        }
+
+        public Task<ProfessionalRole?> GetActiveProfessionalRoleByIdAsync(Guid roleId, CancellationToken cancellationToken = default)
+        {
+            CatalogLookupCount++;
+            return Task.FromResult<ProfessionalRole?>(new ProfessionalRole
+            {
+                ProfessionalRoleId = roleId,
+                Name = "Backend Developer",
+                NameNormalized = "backend developer"
+            });
+        }
+
+        public void SyncUserSkills(UserProfile profile, IReadOnlyCollection<Skill> skills)
+        {
+            SyncCount++;
+            profile.UserSkills.Clear();
+            foreach (var skill in skills)
+                profile.UserSkills.Add(new UserSkill { UserId = profile.UserId, SkillId = skill.SkillId, Skill = skill });
+        }
+
+        public Task SaveChangesAsync(CancellationToken cancellationToken = default)
+        {
+            SaveCount++;
+            return Task.CompletedTask;
+        }
+
+        public async Task<T> ExecuteInTransactionAsync<T>(Guid userId, Func<CancellationToken, Task<T>> operation, CancellationToken cancellationToken = default)
+        {
+            Assert.Equal(User.UserId, userId);
+            TransactionCount++;
+            return await operation(cancellationToken);
+        }
+    }
+}
