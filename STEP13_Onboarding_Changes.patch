@@ -0,0 +1,48 @@
+using System.Text.Json;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Authorization.Policy;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Tindy.Api.Authorization;
+
+public sealed class OnboardingAuthorizationResultHandler
+    : IAuthorizationMiddlewareResultHandler
+{
+    private readonly AuthorizationMiddlewareResultHandler _defaultHandler = new();
+
+    public Task HandleAsync(
+        RequestDelegate next,
+        HttpContext httpContext,
+        AuthorizationPolicy policy,
+        PolicyAuthorizationResult authorizeResult)
+    {
+        var onboardingRequired = authorizeResult.Forbidden &&
+            authorizeResult.AuthorizationFailure?.FailureReasons.Any(
+                reason => reason.Message == OnboardingPolicies.OnboardingRequired) == true;
+
+        if (!onboardingRequired)
+        {
+            // Preserve normal JWT 401 challenges and generic 403 forbids.
+            return _defaultHandler.HandleAsync(
+                next, httpContext, policy, authorizeResult);
+        }
+
+        var problem = new ProblemDetails
+        {
+            Status = StatusCodes.Status403Forbidden,
+            Title = "Forbidden",
+            Detail = "Bạn cần hoàn tất 8 bước onboarding để truy cập chức năng này.",
+            Instance = httpContext.Request.Path.ToString()
+        };
+
+        problem.Extensions["error_code"] = OnboardingPolicies.OnboardingRequired;
+        problem.Extensions["traceId"] = httpContext.TraceIdentifier;
+
+        httpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
+        httpContext.Response.ContentType = "application/problem+json";
+
+        return httpContext.Response.WriteAsync(
+            JsonSerializer.Serialize(problem),
+            httpContext.RequestAborted);
+    }
+}
diff --git a/src/Tindy.Api/Authorization/OnboardingCompletedHandler.cs b/src/Tindy.Api/Authorization/OnboardingCompletedHandler.cs
new file mode 100644
index 0000000..b2be53f
--- /dev/null
+++ b/src/Tindy.Api/Authorization/OnboardingCompletedHandler.cs
@@ -0,0 +1,53 @@
+using Microsoft.AspNetCore.Authorization;
+using Tindy.Application.Interfaces.Repositories;
+using Tindy.Application.Models.Authorization;
+
+namespace Tindy.Api.Authorization;
+
+public sealed class OnboardingCompletedHandler
+    : AuthorizationHandler<OnboardingCompletedRequirement>
+{
+    private readonly IOnboardingAccessReader _reader;
+
+    public OnboardingCompletedHandler(IOnboardingAccessReader reader)
+    {
+        _reader = reader;
+    }
+
+    protected override async Task HandleRequirementAsync(
+        AuthorizationHandlerContext context,
+        OnboardingCompletedRequirement requirement)
+    {
+        if (context.User.Identity?.IsAuthenticated != true ||
+            !Guid.TryParse(context.User.FindFirst("sub")?.Value, out var userId) ||
+            userId == Guid.Empty)
+        {
+            return;
+        }
+
+        // HTTP request cancellation should stop the database query.
+        var ct = (context.Resource as HttpContext)?.RequestAborted
+            ?? CancellationToken.None;
+
+        var status = await _reader.GetStatusAsync(userId, ct);
+
+        switch (status)
+        {
+            case OnboardingAccessStatus.Completed:
+                context.Succeed(requirement);
+                break;
+
+            case OnboardingAccessStatus.Incomplete:
+                context.Fail(new AuthorizationFailureReason(
+                    this,
+                    OnboardingPolicies.OnboardingRequired));
+                break;
+
+            // Inactive/deleted/missing accounts must not pass the gate.
+            // They are not incorrectly reported as incomplete onboarding.
+            case OnboardingAccessStatus.InactiveOrMissing:
+                context.Fail();
+                break;
+        }
+    }
+}
