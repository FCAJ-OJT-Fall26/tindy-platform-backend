{
  "MediaStorage": {
    "Provider": "local",
    "Local": {
      "RootPath": "D:/TindyData/private-media"
    }
  },
  "ClamAv": {
    "Host": "127.0.0.1",
    "Port": 3310,
    "TimeoutSeconds": 30
  },
  "MediaLifecycle": {
    "Enabled": true,
    "PollIntervalSeconds": 30,
    "BatchSize": 50,
    "RejectedRetentionHours": 1
  },
  "GuardDuty": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8443",
      "http://127.0.0.1:8443"
    ]
  },
  "OAuth": {
    "Frontend": {
      "AllowedOrigins": [
        "http://localhost:8443",
        "http://127.0.0.1:8443"
      ]
    }
  }
}
